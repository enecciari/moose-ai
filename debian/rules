#!/usr/bin/make -f

export CARGO_HOME = $(CURDIR)/debian/.cargo
export CARGO_NET_OFFLINE = true

%:
	dh $@ --buildsystem=meson

override_dh_auto_configure:
	cp -r .cargo debian/
	if [ -d "debian/.cargo/vendor" ]; then \
		find debian/.cargo/vendor -name .cargo-checksum.json -exec sed -i 's/"[^"]*\.orig"[^,]*,\?//g' {} \; ; \
		find debian/.cargo/vendor -name .cargo-checksum.json -exec sed -i 's/,\?"[^"]*\.orig"[^:]*:[^,]*//g' {} \; ; \
		find debian/.cargo/vendor -name .cargo-checksum.json -exec sed -i 's/{,/{/g; s/,}/}/g' {} \; ; \
	fi
	if [ -d "vendor" ]; then \
		find vendor -name .cargo-checksum.json -exec sed -i 's/"[^"]*\.orig"[^,]*,\?//g' {} \; ; \
		find vendor -name .cargo-checksum.json -exec sed -i 's/,\?"[^"]*\.orig"[^:]*:[^,]*//g' {} \; ; \
		find vendor -name .cargo-checksum.json -exec sed -i 's/{,/{/g; s/,}/}/g' {} \; ; \
	fi
	dh_auto_configure -- -Dgui=true --wrap-mode=nodownload

